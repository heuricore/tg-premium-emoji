{
  "$id": "https://raw.githubusercontent.com/heuricore/tg-premium-emoji/main/schemas/catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "author",
    "license",
    "description"
  ],
  "title": "CatalogMeta",
  "type": "object"
}
